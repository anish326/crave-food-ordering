# For Vercel, configure these in Project Settings > Environment Variables.
# Keep secrets out of GitHub. Use distinct storage prefixes for preview and production.
FOODORDER_STORAGE=vercel-blob
BLOB_READ_WRITE_TOKEN=
FOODORDER_ADMIN_PASSWORD=
PORT=8080
# Optional: defaults to crave/<VERCEL_ENV>.
# FOODORDER_BLOB_PREFIX=crave/production
