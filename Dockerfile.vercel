FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY FoodOrder.csproj ./
RUN dotnet restore FoodOrder.csproj
COPY . ./
RUN dotnet publish FoodOrder.csproj -c Release --no-restore -o /publish /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
ENV ASPNETCORE_ENVIRONMENT=Production PORT=8080
COPY --from=build /publish ./
USER app
EXPOSE 8080
ENTRYPOINT ["dotnet", "FoodOrder.dll"]
